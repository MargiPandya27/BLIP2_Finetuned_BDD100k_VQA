# Data source
USE_DUMMY_DATA=true
KAGGLE_DATASET=solesensei/solesensei_bdd100k

# Kaggle API credentials (required when USE_DUMMY_DATA=false)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Paths
DATA_ROOT=./data
DUMMY_DATA_ROOT=./data/dummy_bdd100k
PROCESSED_VQA_PATH=./data/processed/bdd100k_risk_vqa.json
ARTIFACTS_DIR=./artifacts
OUTPUT_DIR=./artifacts/blip2-finetuned-vqa

# Hugging Face
HF_TOKEN=your_huggingface_token
EVAL_MODEL_ID=MargiPandya/blip2-finetuned-bdd100k-vqa
EVAL_MODEL_DIR=./artifacts/eval-models/blip2-finetuned-bdd100k-vqa
EVAL_OUTPUT_DIR=./artifacts/eval-results
EVAL_MAX_SAMPLES=
EVAL_MAX_NEW_TOKENS=64
EVAL_MIN_DECISION_ACCURACY=0.8
HF_HOME=D:/hf-cache
PREFETCH_BASE_MODEL=false

# Weights & Biases
WANDB_API_KEY=your_wandb_api_key
WANDB_PROJECT=blip2-vqa
WANDB_ENTITY=your_wandb_entity

# Training
NUM_TRAIN_EPOCHS=2
LEARNING_RATE=5e-5
PER_DEVICE_TRAIN_BATCH_SIZE=4

# Logging
LOG_LEVEL=INFO
